<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_ms" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit.ms</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page string="Configuración Microsoft" name="microsoft_config">
                    <group>
                        <group string="Datos de Licenciamiento">
                            <field name="is_microsoft_product"/>
                            <field name="microsoft_type" 
                                   invisible="not is_microsoft_product" 
                                   required="is_microsoft_product"/>
                        </group>
                        <group string="Sincronización">
                            <field name="microsoft_sku" 
                                   invisible="not is_microsoft_product"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>