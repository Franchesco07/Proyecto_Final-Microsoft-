<odoo>
    <!-- ========================================================
         1. VISTA DE LISTA (TREE / LIST VIEW)
         ======================================================== -->
    <record id="view_microsoft_asset_list" model="ir.ui.view">
        <field name="name">microsoft.asset.list</field>
        <field name="model">microsoft.asset</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'scrapped'" 
                  decoration-warning="status == 'repair'" 
                  decoration-success="status == 'assigned'">
                <field name="serial_number"/>
                <field name="model"/>
                <field name="employee_id"/>
                <field name="warranty_end"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'available'"
                       decoration-success="status == 'assigned'"
                       decoration-warning="status == 'repair'"
                       decoration-danger="status == 'scrapped'"/>
            </list>
        </field>
    </record>

    <!-- ========================================================
         2. VISTA KANBAN (TARJETAS ARRASTRABLES)
         ======================================================== -->
    <record id="view_microsoft_asset_kanban" model="ir.ui.view">
        <field name="name">microsoft.asset.kanban</field>
        <field name="model">microsoft.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="status"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill shadow-sm border-start border-4 card">
                            <div class="oe_kanban_details d-flex flex-column justify-content-between" style="min-height: 80px;">
                                <div>
                                    <strong class="o_kanban_record_title text-primary" style="font-size: 1.1em;">
                                        <field name="model"/>
                                    </strong>
                                </div>
                                <div class="text-muted" style="font-size: 0.9em; margin-top: 5px;">
                                    <strong>S/N:</strong> <field name="serial_number"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2 pt-2 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <i class="fa fa-user me-1 text-muted" title="Empleado responsable"></i>
                                        <span class="text-truncate" style="max-width: 150px; display: inline-block;">
                                            <field name="employee_id"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================
         3. VISTA DE FORMULARIO (FORM VIEW)
         ======================================================== -->
    <record id="view_microsoft_asset_form" model="ir.ui.view">
        <field name="name">microsoft.asset.form</field>
        <field name="model">microsoft.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="available,assigned,repair,scrapped" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="serial_number" class="oe_edit_only" string="Número de Serie de Hardware"/>
                        <h1>
                            <field name="serial_number" placeholder="Ej: SF-XXXXXX-2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Especificaciones Técnicas">
                            <field name="model"/>
                            <field name="warranty_end"/>
                        </group>
                        <group string="Asignación y Custodia">
                            <field name="employee_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================
         4. ACCIÓN DE VENTANA (WINDOW ACTION)
         ======================================================== -->
    <record id="action_microsoft_asset" model="ir.actions.act_window">
        <field name="name">Equipos Surface</field>
        <field name="res_model">microsoft.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra tu primera Laptop/Tablet Microsoft Surface
            </p>
            <p>
                Vincúlala a un empleado y lleva el rastreo de sus garantías y estados de soporte físico de manera visual.
            </p>
        </field>
    </record>

    <!-- ========================================================
         5. MENÚS
         ======================================================== -->
    <menuitem id="menu_microsoft_assets_category" 
              name="Hardware Surface" 
              parent="microsoft_suite.menu_microsoft_suite_root" 
              sequence="20"/>

    <menuitem id="menu_microsoft_asset_action" 
              name="Control de Dispositivos" 
              parent="menu_microsoft_assets_category" 
              action="action_microsoft_asset" 
              sequence="10"/>
</odoo>