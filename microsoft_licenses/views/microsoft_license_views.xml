<odoo>

        <!-- ========================================================
             1. VISTA DE LISTA (LIST VIEW) - Adaptado para Odoo 18
             ======================================================== -->
    <record id="view_microsoft_license_list" model="ir.ui.view">
        <field name="name">microsoft.license.list</field>
        <field name="model">microsoft.license</field>
        <field name="arch" type="xml">
            <!-- Usamos la etiqueta obligatoria <list> de Odoo 18 -->
            <list decoration-info="state == 'draft'" 
                    decoration-success="state == 'active'" 
                    decoration-danger="state == 'expired'">
                <field name="name"/>
                <field name="license_type"/>
                <field name="user_id"/>
                <field name="expiration_date"/>
                <field name="state" widget="badge" 
                        decoration-info="state == 'draft'" 
                        decoration-success="state == 'active'" 
                        decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

        <!-- ========================================================
             2. VISTA DE FORMULARIO (FORM VIEW)
             ======================================================== -->
    <record id="view_microsoft_license_form" model="ir.ui.view">
        <field name="name">microsoft.license.form</field>
        <field name="model">microsoft.license</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" 
                            string="Activar Licencia" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Clave / ID de Licencia"/>
                        <h1>
                            <field name="name" placeholder="Ej: LNK-O365-XXXX-YYYY"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles de Suscripción">
                            <field name="license_type"/>
                            <field name="expiration_date"/>
                        </group>
                        <group string="Asignación">
                            <field name="user_id" placeholder="Selecciona un usuario..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

        <!-- ========================================================
             3. ACCIÓN DE VENTANA (WINDOW ACTION)
             ======================================================== -->
    <record id="action_microsoft_license" model="ir.actions.act_window">
        <field name="name">Licencias de Software</field>
        <field name="res_model">microsoft.license</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra tu primera licencia de Microsoft
            </p>
            <p>
                Lleva el control de tus suscripciones de Microsoft 365, Azure y Power BI de manera centralizada.
            </p>
        </field>
    </record>

        <!-- ========================================================
             4. MENÚS
             ======================================================== -->
    <menuitem id="menu_microsoft_licenses_category" 
                name="Licencias" 
                parent="microsoft_suite.menu_microsoft_suite_root" 
                sequence="10"/>

    <menuitem id="menu_microsoft_license_action" 
                name="Control de Licencias" 
                 parent="menu_microsoft_licenses_category" 
                action="action_microsoft_license" 
                sequence="10"/>

</odoo>
