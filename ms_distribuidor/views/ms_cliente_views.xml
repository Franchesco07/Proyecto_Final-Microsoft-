<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_cliente_list" model="ir.ui.view">
        <field name="name">ms.cliente.list</field>
        <field name="model">ms.cliente</field>
        <field name="arch" type="xml">
            <list string="Clientes">
                <field name="name"/>
                <field name="tipo_identificacion"/>
                <field name="identificacion"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="ciudad"/>
            </list>
        </field>
    </record>

    <record id="view_ms_cliente_form" model="ir.ui.view">
        <field name="name">ms.cliente.form</field>
        <field name="model">ms.cliente</field>
        <field name="arch" type="xml">
            <form string="Cliente">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tipo_identificacion"/>
                            <field name="identificacion"/>
                        </group>
                        <group>
                            <field name="telefono"/>
                            <field name="email"/>
                            <field name="direccion"/>
                            <field name="ciudad"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ms_cliente" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">ms.cliente</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
