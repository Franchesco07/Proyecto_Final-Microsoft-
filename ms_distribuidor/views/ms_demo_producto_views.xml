<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_demo_producto_list" model="ir.ui.view">
        <field name="name">ms.demo_producto.list</field>
        <field name="model">ms.demo_producto</field>
        <field name="arch" type="xml">
            <list string="Demos de producto">
                <field name="name"/>
                <field name="fecha_hora"/>
                <field name="cliente_id"/>
                <field name="producto_id"/>
                <field name="vendedor_id"/>
                <field name="duracion_horas"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_ms_demo_producto_form" model="ir.ui.view">
        <field name="name">ms.demo_producto.form</field>
        <field name="model">ms.demo_producto</field>
        <field name="arch" type="xml">
            <form string="Demo de producto">
                <header>
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_realizada" type="object" string="Marcar realizada"
                            class="btn-primary" invisible="estado != 'confirmada'"/>
                    <button name="action_cancelar" type="object" string="Cancelar"
                            invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="borrador,confirmada,realizada"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cliente_id"/>
                            <field name="producto_id"/>
                            <field name="vendedor_id"/>
                        </group>
                        <group>
                            <field name="fecha_hora"/>
                            <field name="duracion_horas"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notas" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ms_demo_producto" model="ir.actions.act_window">
        <field name="name">Demos de producto</field>
        <field name="res_model">ms.demo_producto</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
