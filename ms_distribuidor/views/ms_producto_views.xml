<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_producto_list" model="ir.ui.view">
        <field name="name">ms.producto.list</field>
        <field name="model">ms.producto</field>
        <field name="arch" type="xml">
            <list string="Productos">
                <field name="name"/>
                <field name="linea"/>
                <field name="categoria"/>
                <field name="version_edicion"/>
                <field name="precio_base"/>
                <field name="iva_valor"/>
                <field name="precio_final"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_ms_producto_form" model="ir.ui.view">
        <field name="name">ms.producto.form</field>
        <field name="model">ms.producto</field>
        <field name="arch" type="xml">
            <form string="Producto">
                <sheet>
                    <group>
                        <group string="Identificacion">
                            <field name="name"/>
                            <field name="linea"/>
                            <field name="categoria"/>
                            <field name="estado"/>
                        </group>
                        <group string="Precios">
                            <field name="precio_base"/>
                            <field name="iva_valor"/>
                            <field name="precio_final"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Datos del producto">
                            <group>
                                <group>
                                    <field name="version_edicion"/>
                                    <field name="anio_lanzamiento"/>
                                    <field name="color"/>
                                </group>
                                <group>
                                    <field name="tipo_licencia"/>
                                </group>
                            </group>
                            <group string="Especificaciones">
                                <field name="especificaciones" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ms_producto_search" model="ir.ui.view">
        <field name="name">ms.producto.search</field>
        <field name="model">ms.producto</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="name"/>
                <field name="version_edicion"/>
                <filter name="filtro_disponible" string="Disponibles"
                        domain="[('estado', '=', 'disponible')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_linea" string="Linea" context="{'group_by': 'linea'}"/>
                    <filter name="group_categoria" string="Categoria" context="{'group_by': 'categoria'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ms_producto" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">ms.producto</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre el primer producto Microsoft</p>
        </field>
    </record>

</odoo>
