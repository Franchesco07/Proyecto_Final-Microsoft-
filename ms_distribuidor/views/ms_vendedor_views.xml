<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_vendedor_list" model="ir.ui.view">
        <field name="name">ms.vendedor.list</field>
        <field name="model">ms.vendedor</field>
        <field name="arch" type="xml">
            <list string="Vendedores">
                <field name="name"/>
                <field name="puesto"/>
                <field name="correo"/>
                <field name="telefono"/>
            </list>
        </field>
    </record>

    <record id="view_ms_vendedor_form" model="ir.ui.view">
        <field name="name">ms.vendedor.form</field>
        <field name="model">ms.vendedor</field>
        <field name="arch" type="xml">
            <form string="Vendedor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="puesto"/>
                        <field name="correo"/>
                        <field name="telefono"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ms_vendedor" model="ir.actions.act_window">
        <field name="name">Vendedores</field>
        <field name="res_model">ms.vendedor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
