<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_venta_list" model="ir.ui.view">
        <field name="name">ms.venta.list</field>
        <field name="model">ms.venta</field>
        <field name="arch" type="xml">
            <list string="Ventas">
                <field name="name"/>
                <field name="fecha"/>
                <field name="cliente_id"/>
                <field name="producto_id"/>
                <field name="vendedor_id"/>
                <field name="precio_base"/>
                <field name="iva_valor"/>
                <field name="total" sum="Total"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_ms_venta_form" model="ir.ui.view">
        <field name="name">ms.venta.form</field>
        <field name="model">ms.venta</field>
        <field name="arch" type="xml">
            <form string="Venta">
                <header>
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary" invisible="estado != 'cotizacion'"/>
                    <button name="action_facturar" type="object" string="Facturar"
                            class="btn-primary" invisible="estado != 'confirmada'"/>
                    <button name="action_volver_cotizacion" type="object" string="Volver a cotizacion"
                            invisible="estado == 'cotizacion'"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="cotizacion,confirmada,facturada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="cliente_id"/>
                            <field name="producto_id"/>
                            <field name="vendedor_id"/>
                            <field name="fecha"/>
                        </group>
                        <group string="Importes">
                            <field name="precio_base"/>
                            <field name="iva_valor"/>
                            <field name="total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ms_venta_search" model="ir.ui.view">
        <field name="name">ms.venta.search</field>
        <field name="model">ms.venta</field>
        <field name="arch" type="xml">
            <search string="Buscar ventas">
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="producto_id"/>
                <field name="vendedor_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_vendedor" string="Vendedor" context="{'group_by': 'vendedor_id'}"/>
                    <filter name="group_producto" string="Producto" context="{'group_by': 'producto_id'}"/>
                    <filter name="group_mes" string="Mes" context="{'group_by': 'fecha:month'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ms_venta_pivot" model="ir.ui.view">
        <field name="name">ms.venta.pivot</field>
        <field name="model">ms.venta</field>
        <field name="arch" type="xml">
            <pivot string="Analisis de ventas">
                <field name="vendedor_id" type="row"/>
                <field name="fecha" interval="month" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ms_venta_graph" model="ir.ui.view">
        <field name="name">ms.venta.graph</field>
        <field name="model">ms.venta</field>
        <field name="arch" type="xml">
            <graph string="Analisis de ventas" type="bar">
                <field name="vendedor_id"/>
                <field name="producto_id"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ms_venta" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">ms.venta</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_ms_venta_analisis" model="ir.actions.act_window">
        <field name="name">Analisis de ventas</field>
        <field name="res_model">ms.venta</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'group_by': ['vendedor_id', 'fecha:month']}</field>
    </record>

</odoo>
